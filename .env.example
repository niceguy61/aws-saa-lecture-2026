# LLM Provider Configuration
LLM_PROVIDER=ollama  # "openai" or "ollama"

# OpenAI API Configuration (optional - only if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Ollama Configuration (default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Embedding Configuration
EMBEDDING_PROVIDER=ollama  # "openai" or "ollama"
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ChromaDB Configuration
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ChromaDB Mode
# - http: connect to server (docker-compose)
# - local: embedded persistent DB (no server)
CHROMA_MODE=http
# Used when CHROMA_MODE=local
CHROMA_PERSIST_DIR=./chroma_local

# Evaluator Agent Configuration
# Set default persona for content evaluation (leave empty to disable)
# Options: 초등학생, 중학생, 고등학생, 대학생, 주니어_DevOps_1년차, 주니어_DevOps_2년차, 시니어_DevOps, IT_비전공자
DEFAULT_PERSONA=

# Content Generation Configuration
# Minimum requirements for lecture content (adjust based on your needs)
MIN_QUIZ_QUESTIONS=5
MIN_QUIZ_QUESTIONS_MULTI_SERVICE=10
MIN_LAB_STEPS=7
MIN_ADVANTAGES=3
MIN_DISADVANTAGES=2
MIN_USE_CASES=3
MIN_TROUBLESHOOTING_SCENARIOS=2

# LangSmith (Optional - for debugging)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=devops-training-agents
